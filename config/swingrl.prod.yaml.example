# config/swingrl.prod.yaml.example — Production reference values (annotated)
# Copy to swingrl.prod.yaml on homelab. NEVER commit real credentials.
# In Docker: override sensitive fields via .env (chmod 600) using SWINGRL_ prefix.
# Example .env line: SWINGRL_TRADING_MODE=live

trading_mode: live  # OVERRIDE via: SWINGRL_TRADING_MODE=live

equity:
  symbols: [SPY, QQQ, VTI, XLV, XLI, XLE, XLF, XLK]
  max_position_size: 0.25       # conservative for Phase 1 live trading
  max_drawdown_pct: 0.10        # 10% DD halts equity — do not raise until Sharpe > 0.7 sustained
  daily_loss_limit_pct: 0.02    # 2% daily loss limit

crypto:
  symbols: [BTCUSDT, ETHUSDT]
  max_position_size: 0.50
  max_drawdown_pct: 0.12        # 12% DD halts crypto
  daily_loss_limit_pct: 0.03    # 3% daily loss limit
  min_order_usd: 10.0           # Binance.US $10 floor — never lower this

capital:
  equity_usd: 400.0             # update when depositing additional capital
  crypto_usd: 47.0              # update when transferring from Coinbase to Binance.US

paths:
  data_dir: /app/data/          # absolute paths in production Docker container
  db_dir: /app/db/
  models_dir: /app/models/
  logs_dir: /app/logs/

logging:
  level: INFO
  json_logs: true               # JSON to stdout — collected by Docker log aggregation
  # Override: SWINGRL_LOGGING__JSON_LOGS=true

system:
  database_url: ""                            # PostgreSQL — set via DATABASE_URL env var (pg16 on br0)

alerting:
  alert_cooldown_minutes: 30               # minimum minutes between repeat alerts
  consecutive_failures_before_alert: 3     # failures before triggering alert

environment:
  zero_turbulence_obs: true                # F1b: freeze the turbulence obs slot at 0.0 before
                                           # inference — era-0 models trained with it frozen, so a
                                           # live value would hit untrained weights (noise). The real
                                           # sensor value is still captured. Flip to false ONLY at the
                                           # era-1 cutover (Plan B automates this off the models table).
                                           # Override: SWINGRL_ENVIRONMENT__ZERO_TURBULENCE_OBS=false

backup:
  backup_retention_days: 14         # keep 2 weeks of database backups
  duckdb_rotate: true               # rotate DuckDB snapshots in production
  backup_dir: /app/backups/         # absolute path in Docker
  offsite_host: ""                  # SET: rsync destination host for off-site backups
  offsite_path: ""                  # SET: rsync destination path

shadow:
  equity_eval_days: 10              # 10 trading days shadow evaluation window
  crypto_eval_cycles: 30            # 30 crypto 4H cycles shadow evaluation
  auto_promote: true                # auto-promote shadow model when it beats active
  mdd_tolerance_ratio: 1.2          # shadow MDD tolerance: 1.2x active MDD

sentiment:
  enabled: false                    # enable when finnhub key + transformers installed
  model_name: ProsusAI/finbert      # HuggingFace sentiment model
  max_headlines_per_asset: 10       # headlines per asset per cycle
  # finnhub_api_key: ""             # OVERRIDE via SWINGRL_SENTIMENT__FINNHUB_API_KEY

security:
  key_rotation_days: 90             # 90-day rotation reminder for API keys
  env_file_permissions: "600"       # .env must be owner-only readable

training:
  bounds:
    # D-T2.1: L1 lever (mid-fold reward-weight nudges from epoch advice) is BENCHED.
    # All six algo/env pairs ship at 0.0 (disabled) — do NOT raise any value above
    # 0.0 without a passing lever-verification harness run first (spec Section 2.3,
    # docs/superpowers/specs/2026-06-12-training-system-redesign-design.md).
    # Prior research values (pre-bench) are documented in
    # .planning/research/algo-reward-shaping.md and kept as bounds.py's fail-open
    # fallback for config-load failure only. OVERRIDE via
    # SWINGRL_TRAINING__BOUNDS__MAX_REWARD_DELTA (JSON-encoded dict).
    max_reward_delta:
      ppo:
        equity: 0.0
        crypto: 0.0
      a2c:
        equity: 0.0
        crypto: 0.0
      sac:
        equity: 0.0
        crypto: 0.0
    adjustment_cooldown_steps:       # minimum timesteps between successive L1 adjustments (unchanged by the bench)
      ppo: 24576                     # 2 × 2048 × 6 (value function recovery)
      a2c: 500                       # ~100 short rollouts (stability window)
      sac: 20000                     # replay buffer rotation

features:
  equity_zscore_window: 252        # rolling z-score window for equity (trading days)
  crypto_zscore_window: 360        # rolling z-score window for crypto (4H bars ~60 days)
  equity_hmm_window: 1260          # HMM fitting window for equity (5 years daily)
  crypto_hmm_window: 2000          # HMM fitting window for crypto (4H bars ~1 year)
  hmm_n_iter: 200                  # max EM iterations per HMM fit
  hmm_n_inits: 5                   # random initializations, best log-likelihood wins
  hmm_ridge: 0.000001             # ridge regularization for HMM covariance stability
  correlation_threshold: 0.85      # Pearson r threshold for feature pruning
  zscore_epsilon: 0.00000001      # floor for rolling std to prevent division by zero
  equity_turbulence_warmup: 252    # expanding lookback warmup for equity turbulence
  crypto_turbulence_window: 1080   # rolling window for crypto turbulence (4H bars)
  crypto_turbulence_warmup: 360    # crypto turbulence minimum warmup bars
